{
  "expo": {
    "name": "Asif & Company",
    "slug": "asif-company-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/coconut.png",
    "scheme": "asifcompanyapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/coconut.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.faizanahmad786.asifcompanyapp"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/coconut.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/Asif & Company Logo.png",
          "imageWidth": 250,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      "@react-native-community/datetimepicker",
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ed330f0d-1e50-459a-8e4e-618295c84b75"
      }
    }
  }
}
